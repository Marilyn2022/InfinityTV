name: Sync upstream LunaTV

on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Check out this repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Merge upstream and open or update a pull request
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git remote add upstream https://github.com/MoonTechLab/LunaTV.git
          git fetch origin main
          git fetch upstream main

          git checkout -B sync/upstream origin/main
          if ! git merge --no-edit upstream/main; then
            git merge --abort || true
            echo "Upstream merge has conflicts. Resolve them manually." >&2
            exit 1
          fi

          if git diff --quiet origin/main HEAD; then
            echo "Local main is already up to date with upstream."
            exit 0
          fi

          git push --force origin HEAD:refs/heads/sync/upstream

          existing_pr=$(gh pr list --head sync/upstream --base main --state open --json number --jq '.[0].number // empty')
          if [ -z "$existing_pr" ]; then
            gh pr create \
              --base main \
              --head sync/upstream \
              --title "chore: sync latest LunaTV upstream" \
              --body "Automated sync from https://github.com/MoonTechLab/LunaTV. Please review before merging."
          else
            echo "Updated existing upstream sync pull request #$existing_pr."
          fi
